local HL1_ENABLED = false
local hl1Connections = {}

local function applyHL1(player)
    if player == LocalPlayer then return end

    local function onChar(char)
        if not HL1_ENABLED then return end
        if char:FindFirstChild("HL1") then return end

        local hl = Instance.new("Highlight")
        hl.Name = "HL1"
        hl.FillColor = Color3.fromRGB(0,255,0)
        hl.OutlineColor = Color3.fromRGB(255,255,255)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
    end

    if player.Character then onChar(player.Character) end
    hl1Connections[player] = player.CharacterAdded:Connect(onChar)
end

