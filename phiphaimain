local SkeletonEnabled = false
local skeletons = {}

local function newLine()
    local l = Drawing.new("Line")
    l.Color = Color3.fromRGB(0,255,0)
    l.Thickness = 2
    l.Transparency = 1
    return l
end

local function clearSkeleton(plr)
    if skeletons[plr] then
        for _,l in pairs(skeletons[plr]) do l:Remove() end
        skeletons[plr] = nil
    end
end

EspTab:CreateToggle({
    Name = "tracer 1",
    CurrentValue = false,
    Flag = "skeleton",
    Callback = function(Value)
        SkeletonEnabled = Value
        if not Value then
            for plr in pairs(skeletons) do
                clearSkeleton(plr)
            end
        end
    end,
})

RunService.RenderStepped:Connect(function()
    if not SkeletonEnabled then return end

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if not skeletons[plr] then
                skeletons[plr] = {newLine()}
            end
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, vis = Camera:WorldToViewportPoint(hrp.Position)
                local line = skeletons[plr][1]
                line.Visible = vis
                line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                line.To = Vector2.new(pos.X, pos.Y)
            end
        end
    end
end)

