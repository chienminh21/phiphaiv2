local function newTracer()
    local l = Drawing.new("Line")
    l.Color = Color3.fromRGB(0,170,255)
    l.Thickness = 2
    l.Transparency = 1
    return l
end

EspTab:CreateToggle({
    Name = "Tracer 2",
    CurrentValue = false,
    Flag = "tracer",
    Callback = function(Value)
        TracerEnabled = Value

        if not Value then
            for _,l in pairs(tracers) do l:Remove() end
            tracers = {}
        end
    end,
})

RunService.RenderStepped:Connect(function()
    if not TracerEnabled then return end
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local from = Camera:WorldToViewportPoint(myHRP.Position)

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not tracers[plr] then
                    tracers[plr] = newTracer()
                end
                local to, vis = Camera:WorldToViewportPoint(hrp.Position)
                tracers[plr].Visible = vis
                tracers[plr].From = Vector2.new(from.X, from.Y)
                tracers[plr].To = Vector2.new(to.X, to.Y)
            end
        end
    end
end)


